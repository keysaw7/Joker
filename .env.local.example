# Clés API pour les adaptateurs IA (serveur uniquement).
# Copiez ce fichier en .env.local et renseignez les clés des fournisseurs que vous utilisez.

# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Generative AI — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Supabase local (Docker) — clé anon de démo, aussi affichée par `npm run db:status`
